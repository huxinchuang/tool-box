/* 暗色金融主题：红涨绿跌 */
.container {
  min-height: 100vh;
  background-color: #0f141b;
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: #161b22;
  border: 1rpx solid #30363d;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #e6edf3;
  margin-bottom: 24rpx;
}

.form-row {
  margin-bottom: 20rpx;
}

.input {
  border: 1rpx solid #30363d;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 28rpx;
  color: #e6edf3;
  background-color: #0d1117;
}

.btn-primary {
  margin-top: 8rpx;
  background-color: #1f6feb;
  color: white;
}

.empty {
  padding: 40rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 26rpx;
  color: #8b949e;
}

.player-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #30363d;
}

.player-item:last-child {
  border-bottom: none;
}

.player-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.player-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #e6edf3;
}

.player-username {
  font-size: 22rpx;
  color: #6e7681;
  margin-top: 4rpx;
}

.player-balance {
  font-size: 26rpx;
  color: #58a6ff;
  margin-top: 8rpx;
  font-family: ui-monospace, Consolas, "Courier New", monospace;
}

.player-actions {
  display: flex;
  gap: 12rpx;
}

.mini-btn {
  margin: 0;
  font-size: 24rpx;
  background-color: #21262d;
  color: #c9d1d9;
}

.mini-btn-add {
  background-color: rgba(239, 83, 80, 0.15);
  color: #ef5350;
}

.mini-btn-deduct {
  background-color: rgba(38, 166, 154, 0.15);
  color: #26a69a;
}

/* 加减币半屏面板 */
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 10;
}

.adjust-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #161b22;
  border: 1rpx solid #30363d;
  border-radius: 28rpx 28rpx 0 0;
  padding: 32rpx;
  z-index: 11;
  transform: translateY(110%);
  transition: transform 0.25s ease;
}

.panel-show {
  transform: translateY(0);
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.panel-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #e6edf3;
}

.panel-close {
  font-size: 36rpx;
  color: #8b949e;
  padding: 8rpx;
}

.panel-row {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.panel-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #8b949e;
  flex-shrink: 0;
}

.panel-value {
  font-size: 28rpx;
  color: #e6edf3;
}

.panel-input {
  flex: 1;
  border: 1rpx solid #30363d;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #e6edf3;
  background-color: #0d1117;
}

.panel-btn {
  margin-top: 12rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  color: white;
}

/* 红涨绿跌：增加=红，扣减=青绿 */
.btn-add {
  background-color: #ef5350;
  box-shadow: 0 6rpx 20rpx rgba(239, 83, 80, 0.3);
}

.btn-deduct {
  background-color: #26a69a;
  box-shadow: 0 6rpx 20rpx rgba(38, 166, 154, 0.3);
}
