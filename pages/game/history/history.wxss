/* 暗色金融主题：红涨绿跌 */
.container {
  min-height: 100vh;
  background-color: #0f141b;
  padding: 24rpx;
  box-sizing: border-box;
}

.summary {
  padding: 8rpx 8rpx 20rpx;
}

.summary-text {
  font-size: 26rpx;
  color: #8b949e;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #8b949e;
}

.tx-list {
  background: #161b22;
  border: 1rpx solid #30363d;
  border-radius: 28rpx;
  overflow: hidden;
}

.tx-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #30363d;
}

.tx-item:last-child {
  border-bottom: none;
}

.tx-left {
  display: flex;
  flex-direction: column;
}

.tx-amount {
  font-size: 40rpx;
  font-weight: bold;
  font-family: ui-monospace, Consolas, "Courier New", monospace;
}

/* 红涨绿跌 */
.amount-plus {
  color: #ef5350;
}

.amount-minus {
  color: #26a69a;
}

.tx-balance {
  font-size: 24rpx;
  color: #8b949e;
  margin-top: 6rpx;
}

.tx-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  max-width: 60%;
}

.tx-remark {
  font-size: 28rpx;
  color: #e6edf3;
  margin-bottom: 6rpx;
  text-align: right;
}

.tx-meta {
  font-size: 22rpx;
  color: #6e7681;
}

.load-status {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #484f58;
}
