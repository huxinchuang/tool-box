.container {
  min-height: 100vh;
  background-color: #f0f2f5;
  padding: 24rpx;
  box-sizing: border-box;
}

.summary {
  padding: 8rpx 8rpx 20rpx;
}

.summary-text {
  font-size: 26rpx;
  color: #999;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.tx-list {
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

.tx-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.tx-item:last-child {
  border-bottom: none;
}

.tx-left {
  display: flex;
  flex-direction: column;
}

.tx-amount {
  font-size: 40rpx;
  font-weight: bold;
}

.amount-plus {
  color: #07c160;
}

.amount-minus {
  color: #e64340;
}

.tx-balance {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}

.tx-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  max-width: 60%;
}

.tx-remark {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 6rpx;
  text-align: right;
}

.tx-meta {
  font-size: 22rpx;
  color: #aaa;
}

.load-status {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #bbb;
}
