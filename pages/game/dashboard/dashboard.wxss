/* 暗色金融主题：GitHub 暗色风，红涨绿跌 */
.container {
  min-height: 100vh;
  background-color: #0f141b;
  padding: 40rpx;
  box-sizing: border-box;
}

/* 余额主卡片：深色面板 + 蓝色光晕 */
.balance-card {
  background: linear-gradient(135deg, #1f2430 0%, #161b22 60%);
  border: 1rpx solid rgba(88, 166, 255, 0.35);
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 32rpx;
  color: #e6edf3;
  box-shadow: 0 8rpx 28rpx rgba(31, 111, 235, 0.18);
}

.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  margin-right: 16rpx;
}

.role-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  color: white;
}

.role-admin {
  background-color: #1f6feb;
}

.role-player {
  background-color: #30363d;
  color: #8b949e;
}

.balance-label {
  display: block;
  font-size: 26rpx;
  color: #8b949e;
  margin-bottom: 12rpx;
}

/* 余额数字：等宽字体 + 强调蓝（参考页数字风格） */
.balance-num {
  font-size: 88rpx;
  font-weight: bold;
  color: #58a6ff;
  font-family: ui-monospace, Consolas, "Courier New", monospace;
}

.balance-unit {
  font-size: 28rpx;
  margin-left: 12rpx;
  color: #8b949e;
}

/* 折线图卡片 */
.chart-card {
  background: #161b22;
  border: 1rpx solid #30363d;
  border-radius: 28rpx;
  padding: 24rpx 24rpx 8rpx;
  margin-bottom: 32rpx;
}

.chart-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #e6edf3;
  margin-bottom: 12rpx;
}

.chart-canvas {
  width: 100%;
  height: 380rpx;
}

/* 功能菜单 */
.menu-card {
  background: #161b22;
  border: 1rpx solid #30363d;
  border-radius: 28rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #30363d;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #1c2128;
}

.menu-icon {
  font-size: 44rpx;
  margin-right: 24rpx;
}

.menu-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #e6edf3;
  margin-bottom: 6rpx;
}

.menu-desc {
  font-size: 24rpx;
  color: #8b949e;
}

.menu-arrow {
  font-size: 40rpx;
  color: #484f58;
}

.actions {
  margin-top: 48rpx;
}

.logout-btn {
  background: #161b22;
  border: 1rpx solid #f85149;
  color: #f85149;
  border-radius: 44rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}

.back {
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #8b949e;
}
