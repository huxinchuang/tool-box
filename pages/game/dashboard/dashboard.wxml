<view class="container">
  <!-- 余额卡片 -->
  <view class="balance-card">
    <view class="user-info">
      <text class="nickname">{{user.nickname || user.username}}</text>
      <text class="role-tag {{isAdmin ? 'role-admin' : 'role-player'}}">{{roleText}}</text>
    </view>
    <text class="balance-label">{{scopeLabel}}游戏币余额</text>
    <text class="balance-num">{{balance}}</text>
    <text class="balance-unit">个</text>
  </view>

  <!-- 分组选择（单选/多选/全部） -->
  <view class="group-card" wx:if="{{hasGroups}}">
    <scroll-view scroll-x="true" class="chips-scroll" enable-flex="false">
      <view class="chip {{selectedGroupIds.length === 0 ? 'chip-active' : ''}}" bindtap="selectAllGroups">全部</view>
      <view class="chip {{item.active ? 'chip-active' : ''}}" wx:for="{{displayGroups}}" wx:key="id" data-id="{{item.id}}" bindtap="toggleGroup">{{item.name}}</view>
    </scroll-view>
    <!-- 多选分组余额摘要 -->
    <view class="group-summary" wx:if="{{groupSummary.length > 0}}">
      <view class="summary-row" wx:for="{{groupSummary}}" wx:key="id">
        <text class="summary-name">{{item.name}}</text>
        <text class="summary-balance">{{item.balance}} 个</text>
      </view>
    </view>
  </view>

  <!-- 余额变化折线图 -->
  <view class="chart-card">
    <view class="chart-title">余额变化趋势</view>
    <canvas type="2d" id="balanceChart" class="chart-canvas"></canvas>
  </view>

  <!-- 功能入口 -->
  <view class="menu-card">
    <view class="menu-item" bindtap="goHistory">
      <text class="menu-icon">📋</text>
      <view class="menu-info">
        <text class="menu-name">变动历史</text>
        <text class="menu-desc">查看游戏币的每笔增减记录</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" wx:if="{{isAdmin}}" bindtap="goAdmin">
      <text class="menu-icon">⚙️</text>
      <view class="menu-info">
        <text class="menu-name">玩家管理</text>
        <text class="menu-desc">创建玩家账号、加减游戏币</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="actions">
    <button class="logout-btn" bindtap="logout">退出登录</button>
    <view class="back" bindtap="goHome">← 返回工具箱</view>
  </view>
</view>
